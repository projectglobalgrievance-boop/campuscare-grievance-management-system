# ============================================================================
# CampusCare - YOUR keys
#
# This file is empty on purpose. The local run (code/mac/run.sh or
# code\windows\run.bat) does not need it at all.
#
# Fill it in only when you connect the project to your OWN Firebase project
# and your OWN hosted AI service. Where each value comes from is explained,
# click by click, in:
#
#     guidelines/04-keys/Keys-and-Environment.pdf
#     guidelines/05-firebase/Firebase-Setup-Guide.pdf
#
# Rules for this file:
#   - one value per line, written as NAME=value
#   - no spaces around the = sign, no quotation marks
#   - lines that start with # are notes and are ignored
# ============================================================================

# --- From your Firebase project (google-services.json) ----------------------
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- The web address of your hosted AI service ------------------------------
# Example: https://campuscare-ai-xxxx.onrender.com   (no / at the end)
AI_SERVICE_URL=
